#
# GENERAL
#

USER_CONF_PATH=/azerothcore/apps/docker/config-docker.sh
DATAPATH=/azerothcore/env/dist/data

#
# COMPILER
#

CTYPE=RelWithDebInfo
CSCRIPTS=static
AC_CCACHE=true

#
# SIMPLE RESTARTER
#
AC_RESTARTER_BINPATH=
AC_RESTARTER_BINFILE=
AC_RESTARTER_WITHGDB=

#
# WORLD SERVER - GLOBAL DIFFICULTY
#
# Creature health, melee damage and spell damage multipliers per rank
# (normal, elite, rare-elite, worldboss, rare). Native core rates
# (worldserver.conf `Rate.Creature.*`), read once at startup; a worldserver
# restart is required to apply a change. Rewards (XP, loot, reputation) are
# untouched. Kept here, as environment overrides, so the setting is
# versioned instead of living only in the gitignored worldserver.conf.
# Rates apply on EVERY map, dungeons and raids included.
#
AC_RATE_CREATURE_NORMAL_DAMAGE=1.35
AC_RATE_CREATURE_ELITE_ELITE_DAMAGE=1.40
AC_RATE_CREATURE_ELITE_RARE_DAMAGE=1.40
AC_RATE_CREATURE_ELITE_RAREELITE_DAMAGE=1.40
AC_RATE_CREATURE_ELITE_WORLDBOSS_DAMAGE=1.40
AC_RATE_CREATURE_NORMAL_SPELL_DAMAGE=1.30
AC_RATE_CREATURE_ELITE_ELITE_SPELL_DAMAGE=1.30
AC_RATE_CREATURE_ELITE_RARE_SPELL_DAMAGE=1.30
AC_RATE_CREATURE_ELITE_RAREELITE_SPELL_DAMAGE=1.30
AC_RATE_CREATURE_ELITE_WORLDBOSS_SPELL_DAMAGE=1.30
AC_RATE_CREATURE_NORMAL_HP=1.20
AC_RATE_CREATURE_ELITE_ELITE_HP=1.50
AC_RATE_CREATURE_ELITE_RARE_HP=1.50
AC_RATE_CREATURE_ELITE_RAREELITE_HP=1.50
AC_RATE_CREATURE_ELITE_WORLDBOSS_HP=1.50
#
# Aggro radius: +20% over the 3.3.5a default (Rate.Creature.Aggro = 1.0).
# Read at startup because visibility distances are clamped to it; a
# worldserver restart is required.
#
AC_RATE_CREATURE_AGGRO=1.20
#
# WORLD SERVER - PLAYER REGENERATION
#
# VanillaRegen.Enable=1 switches player HP/mana regeneration to the exact
# 1.12.1 formulas (class + Spirit), bypassing the WotLK gt*regen DBC tables.
# Rate.Health/Rate.Mana stay at 1.0 so the vanilla formulas are not scaled.
# Keep EnableLowLevelRegenBoost=0: 1.12 has no WotLK low-level boost.
#
AC_VANILLA_REGEN_ENABLE=1
AC_RATE_HEALTH=1.0
AC_RATE_MANA=1.0

#
# WORLD SERVER - EXPERIENCE RATES
#
# Rate.XP.Kill / Rate.XP.Quest / Rate.XP.Quest.DF / Rate.XP.Explore /
# Rate.XP.BattlegroundBonus: native worldserver.conf XP rates, read once at
# startup; a worldserver restart is required to apply a change. Global -10%
# on every player XP source active today (mob kills, quests, LFG quests,
# exploration, battleground objectives). Pet XP follows the kill rate
# automatically (Rate.XP.Pet untouched). BG honorable-kill XP stays disabled
# (Battleground.GiveXPForKills = 0), its rates are left untouched.
#
AC_RATE_XP_KILL=0.9
AC_RATE_XP_QUEST=0.9
AC_RATE_XP_QUEST_DF=0.9
AC_RATE_XP_EXPLORE=0.9
AC_RATE_XP_BATTLEGROUND_BONUS=0.9
